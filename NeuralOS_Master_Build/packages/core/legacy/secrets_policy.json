{
  "schemaVersion": 1,
  "requiredEnv": [
    "FORGE_MASTER_PASSPHRASE"
  ],
  "sensitiveConfigKeys": [
    "security.masterPassphrase",
    "security.signingKey",
    "security.privateKey"
  ],
  "allowVaultFileSource": true,
  "allowedSources": [
    "env",
    "vault_file"
  ],
  "maxBreakGlassHours": 72
}
